# Nutrient Python SDK license key. Empty = evaluation mode.
NUTRIENT_LICENSE_KEY=
# OpenAI-compatible endpoint and model that write the answers (Ollama by default).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# API key of that endpoint. Leave empty for Ollama.
LLM_API_KEY=
# Embedding model. EMBEDDING_BASE_URL and EMBEDDING_API_KEY default to the LLM values.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Number of chunks retrieved for each question.
TOP_K=5
# Documents to ingest, and where the Markdown, chunks and vectors are written.
DOCUMENTS_FOLDER=samples/documents
OUTPUT_FOLDER=output
# Address of the question answering page.
HOST=127.0.0.1
PORT=8000
